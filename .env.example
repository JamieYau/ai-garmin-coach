# App environment
APP_ENV=development
LOG_LEVEL=info

# Local service ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Public URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
GARMIN_CONNECTION_RATE_LIMIT_MAX_REQUESTS=5
GARMIN_CONNECTION_RATE_LIMIT_WINDOW_SECONDS=60
MANUAL_SYNC_RATE_LIMIT_MAX_REQUESTS=3
MANUAL_SYNC_RATE_LIMIT_WINDOW_SECONDS=60
AI_INSIGHT_RATE_LIMIT_MAX_REQUESTS=3
AI_INSIGHT_RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL
POSTGRES_DB=garmin_coach
POSTGRES_USER=garmin_coach
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://garmin_coach:change-me-local-only@localhost:5432/garmin_coach

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_DATABASE_URL=postgresql://garmin_coach:change-me-local-only@localhost:5432/garmin_coach
BETTER_AUTH_SECURE_COOKIES=false
BETTER_AUTH_RATE_LIMIT_ENABLED=false
BETTER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BETTER_AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Local demo account, for seeded development data only
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=demo-password-local-only
DEMO_USER_NAME=Demo Runner

# AI provider
AI_PROVIDER=mock
OPENAI_API_KEY=replace-with-local-key-when-ai-provider-is-enabled
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=1200

# Garmin connector setup, for local development only
GARMIN_USERNAME=replace-with-local-garmin-username
GARMIN_PASSWORD=replace-with-local-garmin-password

# Production reference (do not put these values in a committed file)
# APP_ENV=production
# FRONTEND_URL=https://your-frontend-origin
# BETTER_AUTH_URL=https://your-frontend-origin
# NEXT_PUBLIC_API_BASE_URL=https://your-api-origin
# BACKEND_CORS_ORIGINS=https://your-frontend-origin
# BACKEND_CORS_ALLOW_CREDENTIALS=true
# BETTER_AUTH_SECURE_COOKIES=true
# BETTER_AUTH_RATE_LIMIT_ENABLED=true
# RATE_LIMIT_ENABLED=true
# DATABASE_URL=postgresql+psycopg://...:5432/garmin_coach?sslmode=require
# BETTER_AUTH_DATABASE_URL=postgresql://...:5432/garmin_coach?sslmode=require
# BETTER_AUTH_SECRET=generate-and-store-only-in-key-vault
