# App environment
APP_ENV=development
LOG_LEVEL=info

# Local service ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Public URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=garmin_coach
POSTGRES_USER=garmin_coach
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://garmin_coach:change-me-local-only@localhost:5432/garmin_coach

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret

# AI provider
AI_PROVIDER=mock
OPENAI_API_KEY=replace-with-local-key-when-ai-provider-is-enabled

# Garmin connector setup, for local development only
GARMIN_USERNAME=replace-with-local-garmin-username
GARMIN_PASSWORD=replace-with-local-garmin-password
